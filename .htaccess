# 237BIZ — .htaccess
# Clean URLs + Security headers

Options -Indexes
Options -MultiViews

RewriteEngine On

# ── SECURITY ─────────────────────────────────────────────
# Block direct access to sensitive directories
RewriteRule ^sessions/ - [F,L]
RewriteRule ^includes/ - [F,L]
RewriteRule ^admin/includes/ - [F,L]
RewriteRule ^vendor/ - [F,L]

# Block direct access to automation internals (queue.php allowed, helper/cron not)
RewriteRule ^automation/helper\.php - [F,L]
RewriteRule ^automation/cron\.php - [F,L]
RewriteRule ^automation/n8n-workflow\.json - [F,L]

# Block test/reset scripts
RewriteRule ^test-email\.php - [F,L]
RewriteRule ^reset-admin.*\.php - [F,L]

# Block access to SQL files
<FilesMatch "\.(sql|log|env|bak|cfg)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://api.qrserver.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none';"
</IfModule>

# ── CLEAN URLS ────────────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Listings
RewriteRule ^listing/([a-z0-9-]+)/?$   listing.php?slug=$1          [L,QSA]
RewriteRule ^r/([a-zA-Z0-9_-]+)/?$   ref.php?code=$1          [L,QSA]
RewriteRule ^listings/?$                listings.php                 [L,QSA]
RewriteRule ^category/([a-z0-9-]+)/?$  listings.php?category=$1     [L,QSA]
RewriteRule ^location/([a-z0-9-]+)/?$  location.php?slug=$1         [L,QSA]

# Listing management
RewriteRule ^add-listing/?$             add-listing.php              [L,QSA]
RewriteRule ^edit-listing/?$            edit-listing.php             [L,QSA]
RewriteRule ^claim-listing/?$           claim-listing.php            [L,QSA]
RewriteRule ^upgrade-listing/?$         upgrade-listing.php          [L,QSA]

# Products & services
RewriteRule ^product/([0-9]+)/?$        product.php?id=$1            [L,QSA]
RewriteRule ^products/?$                products.php                 [L,QSA]
RewriteRule ^manage-products/?$         manage-products.php          [L,QSA]
RewriteRule ^services/?$                services.php                 [L,QSA]
RewriteRule ^online-presence/?$         online-presence.php          [L,QSA]
RewriteRule ^business-listing/?$        business-listing.php         [L,QSA]

# Bookings
RewriteRule ^booking/?$                 booking.php                  [L,QSA]
RewriteRule ^manage-bookings/?$         manage-bookings.php          [L,QSA]

# Analytics & announcements
RewriteRule ^analytics/?$               analytics.php                [L,QSA]
RewriteRule ^manage-announcements/?$    manage-announcements.php     [L,QSA]

# Help / Knowledge base
RewriteRule ^help/?$                    help.php                     [L,QSA]
RewriteRule ^help/([a-z0-9-]+)/?$       help-article.php?slug=$1    [L,QSA]

# Account
RewriteRule ^login/?$                   login.php                    [L,QSA]
RewriteRule ^register/?$                login.php?mode=register      [L,QSA]
RewriteRule ^logout/?$                  logout.php                   [L,QSA]
RewriteRule ^dashboard/?$               dashboard.php                [L,QSA]
RewriteRule ^profile/?$                 profile.php                  [L,QSA]
RewriteRule ^verify/?$                  verify.php                   [L,QSA]
RewriteRule ^reset-password/?$          reset-password.php           [L,QSA]

# Admin
RewriteRule ^admin/?$                   admin/index.php              [L,QSA]
RewriteRule ^admin/manage-growth-partners/?$ admin/manage-growth-partners.php [L,QSA]

# Utility
RewriteRule ^enquiry/?$                 enquiry.php                  [L,QSA]
RewriteRule ^subscribe/?$               subscribe.php                [L,QSA]
RewriteRule ^unsubscribe/?$             unsubscribe.php              [L,QSA]
RewriteRule ^track-click/?$             track-click.php              [L,QSA]
RewriteRule ^validate-promo/?$          validate-promo.php           [L,QSA]
RewriteRule ^sitemap\.xml$              sitemap.php                  [L,QSA]


# Agent portal
RewriteRule ^agent/dashboard/?$      agent/dashboard.php      [L,QSA]

# Creator portal
RewriteRule ^creator/dashboard/?$    creator/dashboard.php    [L,QSA]
RewriteRule ^creator/profile/?$      creator/profile.php      [L,QSA]
RewriteRule ^creator/campaigns/?$    creator/campaigns.php    [L,QSA]
RewriteRule ^creator/submissions/?$  creator/submissions.php  [L,QSA]
RewriteRule ^creator/referrals/?$    creator/referrals.php    [L,QSA]

# Growth Partner portal
RewriteRule ^partner/dashboard/?$    partner/dashboard.php    [L,QSA]
RewriteRule ^partner/portfolio/?$    partner/portfolio.php    [L,QSA]
RewriteRule ^partner/business/?$     partner/business.php     [L,QSA]
RewriteRule ^partner/tasks/?$        partner/tasks.php        [L,QSA]
RewriteRule ^partner/leads/?$        partner/leads.php        [L,QSA]
RewriteRule ^partner/commissions/?$  partner/commissions.php  [L,QSA]
RewriteRule ^partner/pending/?$      partner/pending.php      [L,QSA]
RewriteRule ^partner/campaigns/?$    partner/campaigns.php    [L,QSA]
RewriteRule ^partner/content/?$      partner/content.php      [L,QSA]
RewriteRule ^partner/reports/?$          partner/reports.php          [L,QSA]
RewriteRule ^partner/recommendations/?$  partner/recommendations.php  [L,QSA]
RewriteRule ^partner/templates/?$        partner/templates.php        [L,QSA]
RewriteRule ^partner/ai-plan/?$          partner/ai-plan.php          [L,QSA]
RewriteRule ^partner/alerts/?$           partner/alerts.php           [L,QSA]
RewriteRule ^partner/automation/?$       partner/automation.php       [L,QSA]
RewriteRule ^partner/profile/?$          partner/profile.php          [L,QSA]
RewriteRule ^partner/onboarding/?$       partner/onboarding.php       [L,QSA]
RewriteRule ^partner-request/?$          partner-request.php          [L,QSA]

# Join & Partners
RewriteRule ^join/?$       join.php      [L,QSA]
RewriteRule ^partners/?$   partners.php  [L,QSA]

# Business Hub & Online Presence
RewriteRule ^business-hub/?$      business-hub.php      [L,QSA]
RewriteRule ^online-presence/?$   online-presence.php   [L,QSA]

RewriteRule ^reviews/?$       reviews.php     [L,QSA]

RewriteRule ^locations/?$      locations.php   [L,QSA]
RewriteRule ^privacy-policy/?$  privacy-policy.php  [L,QSA]
RewriteRule ^terms/?$           terms.php           [L,QSA]
RewriteRule ^contact/?$         contact.php         [L,QSA]

# ── CACHING ───────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# ── GZIP COMPRESSION ──────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
